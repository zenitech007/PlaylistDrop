# Base URL of the FastAPI backend for browser calls
# When managed via Firebase Config (/appConfig/runtime in Firestore), Firestore takes precedence.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-side FastAPI backend URL (used by Next.js /api/* proxy routes)
# If left blank, Next.js server routes read fastapiUrl from Firestore (/appConfig/runtime).
FASTAPI_URL=http://localhost:8000
