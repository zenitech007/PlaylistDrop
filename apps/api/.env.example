# Spotify Web API (Client Credentials flow — free app at https://developer.spotify.com)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# YouTube Data API v3 (free API key from Google Cloud Console)
# If left blank and USE_FIREBASE_YOUTUBE_KEY=true, FastAPI falls back to firebase-applet-config.json.
YOUTUBE_API_KEY=
USE_FIREBASE_YOUTUBE_KEY=true
FIREBASE_CONFIG_PATH=

# Jamendo API v3 (free app at https://dev.jamendo.com)
JAMENDO_CLIENT_ID=

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:3000

# Optional runtime tuning
RATE_LIMIT_PER_MINUTE=30
MAX_PLAYLIST_TRACKS=200
MAX_DOWNLOAD_MB=50
MATCH_REGISTRY_TTL_SECONDS=600
PROVIDER_TIMEOUT_SECONDS=10.0
MAX_MATCH_CONCURRENCY=5
LOG_LEVEL=INFO
