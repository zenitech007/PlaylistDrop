# Public URL where the Next.js app is hosted
APP_URL="http://localhost:3000"

# Frontend & Server API URLs
# Optional overrides: if left empty, PlaylistDrop reads FASTAPI_URL and NEXT_PUBLIC_API_URL
# from Firebase Firestore (/appConfig/runtime) configured via firebase-applet-config.json.
NEXT_PUBLIC_API_URL=""
FASTAPI_URL=""

# Backend credentials (leave empty for credential-free Deezer playlists)
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
# Optional override: if empty and useFirebaseYoutubeKey is enabled in Firestore,
# server routes fall back to the provisioned Google Cloud Firebase project API key.
YOUTUBE_API_KEY=""
JAMENDO_CLIENT_ID=""

# Allowed CORS origins for apps/api (comma-separated)
CORS_ORIGINS="http://localhost:3000"
